<%- include('_layout') %>
<p class="eyebrow">Overview</p>
<h1 class="display-m mb-3">Store status</h1>

<dl class="stat-grid">
  <div class="stat"><dt>Orders</dt><dd><%= stats.orders %></dd></div>
  <div class="stat"><dt>Paid orders</dt><dd><%= stats.paidOrders %></dd></div>
  <div class="stat"><dt>Recorded revenue</dt><dd><%= inr(stats.revenue) %></dd></div>
  <div class="stat"><dt>Open support</dt><dd><%= stats.openTickets %></dd></div>
  <div class="stat"><dt>Open grievances</dt><dd><%= stats.grievances %></dd></div>
  <div class="stat"><dt>Open privacy requests</dt><dd><%= stats.openDsar %></dd></div>
  <div class="stat"><dt>Reviews awaiting moderation</dt><dd><%= stats.pendingReviews %></dd></div>
  <div class="stat"><dt>Low stock variants</dt><dd><%= stats.lowStock %></dd></div>
</dl>

<div class="two-col">
  <section>
    <h2 class="eyebrow">Recent orders</h2>
    <% if (!recentOrders.length) { %>
      <p class="small muted">No orders yet. Once a test order is placed it appears here.</p>
    <% } else { %>
      <table class="admin-table">
        <thead><tr><th>Ref</th><th>Placed</th><th>Total</th><th>Payment</th><th>Status</th></tr></thead>
        <tbody>
          <% recentOrders.forEach(function (o) { %>
            <tr>
              <td><a href="/admin/orders/<%= o.ref %>"><%= o.ref %></a></td>
              <td><%= fmtDateTime(o.created_at) %></td>
              <td><%= inr(o.total_paise) %></td>
              <td><%= o.payment_method %> · <%= o.payment_status %></td>
              <td><%= o.order_status %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </section>
  <section>
    <h2 class="eyebrow">Recent privacy requests</h2>
    <% if (!recentDsar.length) { %>
      <p class="small muted">No privacy requests raised yet.</p>
    <% } else { %>
      <table class="admin-table">
        <thead><tr><th>Ref</th><th>Type</th><th>Status</th><th>Due</th></tr></thead>
        <tbody>
          <% recentDsar.forEach(function (d) { %>
            <tr>
              <td><a href="/admin/data-requests/<%= d.ref %>"><%= d.ref %></a></td>
              <td><%= d.request_type %></td>
              <td><%= d.status %></td>
              <td><%= fmtDate(d.due_by) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </section>
</div>

<section class="mt-3">
  <h2 class="eyebrow">Launch readiness</h2>
  <p class="small measure">
    The full requirement-by-requirement report, including items marked NOT CONFIGURED and NEEDS HUMAN REVIEW,
    is generated from live checks rather than hand-written.
  </p>
  <p><a class="btn btn--small" href="/launch-readiness">Open the launch-readiness report</a></p>
</section>
<%- include('_layout-end') %>
