<dialog id="cart-drawer" class="cart-drawer" aria-labelledby="cart-drawer-title">
  <div class="cart-drawer-head">
    <h2 id="cart-drawer-title">Your bag</h2>
    <button class="icon-btn" type="button" data-cart-close>
      <span class="sr-only">Close bag</span>
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M1 1l14 14M15 1L1 15" stroke="currentColor" stroke-width="1.6"/></svg>
