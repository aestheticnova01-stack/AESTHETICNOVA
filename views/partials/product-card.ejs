<article class="card">
  <div class="card-media">
    <a href="/product/<%= p.slug %>" tabindex="-1" aria-hidden="true">
      <img src="<%= p.image %>" alt="" width="480" height="600" loading="lazy" decoding="async">
    </a>
    <div class="card-flags">
      <% if (p.new_arrival && p.created_at && (Date.now() - new Date(p.created_at.replace(' ', 'T') + 'Z').getTime()) < 1000*60*60*24*45) { %>
        <span class="flag flag--dark">New</span>
      <% } %>
      <% if (p.stock === 0) { %><span class="flag flag--out">Sold out</span><% } %>
    </div>
    <button class="wish-btn" type="button" data-wishlist="<%= p.id %>"
      aria-pressed="<%= wishlistIds && wishlistIds.includes(p.id) ? 'true' : 'false' %>"
      aria-label="<%= wishlistIds && wishlistIds.includes(p.id) ? 'Remove' : 'Save' %> <%= p.name %> <%= wishlistIds && wishlistIds.includes(p.id) ? 'from' : 'to' %> wishlist">
      <svg width="17" height="17" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 17s-7-4.35-7-9a4 4 0 017-2.6A4 4 0 0117 8c0 4.65-7 9-7 9z" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
    </button>
  </div>
  <div class="card-body">
    <h3 class="card-title"><a href="/product/<%= p.slug %>"><%= p.name %></a></h3>
    <div class="card-meta">
      <span class="price"><%= p.priceLabel %></span>
      <span class="card-sub"><%= p.material %></span>
    </div>
    <% if (p.review && p.review.count > 0) { %>
      <p class="rating-line mb-0">
        <span class="stars" aria-hidden="true"><%= '★'.repeat(Math.round(p.review.average)) %><%= '☆'.repeat(5 - Math.round(p.review.average)) %></span>
        <span><%= p.review.average.toFixed(1) %> · <%= p.review.count %> verified review<%= p.review.count === 1 ? '' : 's' %></span>
      </p>
    <% } else { %>
      <p class="rating-line mb-0"><span>No reviews yet</span></p>
    <% } %>
    <p class="small muted mb-0"><%= p.stock > 0 ? `${p.stock} in stock` : 'Currently sold out' %></p>
  </div>
</article>
