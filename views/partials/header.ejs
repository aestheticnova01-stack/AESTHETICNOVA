<div class="topbar">
  <p class="mb-0">
    Free shipping over <%= typeof freeShipLabel !== 'undefined' ? freeShipLabel : '₹1,499' %> &nbsp;·&nbsp; GST included in all prices
  </p>
</div>

<header class="site-header">
  <div class="wrap">
    <div class="header-inner">
      <button class="icon-btn menu-toggle" type="button" id="menu-toggle" aria-expanded="false" aria-controls="mobile-nav">
        <span class="sr-only">Open menu</span>
        <svg width="20" height="14" viewBox="0 0 20 14" aria-hidden="true" focusable="false"><path d="M0 1h20M0 7h20M0 13h20" stroke="currentColor" stroke-width="1.6"/></svg>
      </button>

      <a class="brand" href="/">AESTHETIC<span>NOVA</span></a>

      <%- include('navbar') %>

      <div class="header-utils">
        <button class="icon-btn" type="button" id="search-toggle" aria-expanded="false" aria-controls="search-panel">
          <span class="sr-only">Search products</span>
          <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M13 13l5 5" stroke="currentColor" stroke-width="1.6"/></svg>
        </button>
        <a class="icon-btn header-wish" href="/account/wishlist">
          <span class="sr-only">Wishlist</span>
          <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 17s-7-4.35-7-9a4 4 0 017-2.6A4 4 0 0117 8c0 4.65-7 9-7 9z" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        </a>
        <a class="icon-btn" href="<%= typeof user !== 'undefined' && user ? '/account' : '/account/login' %>">
          <span class="sr-only"><%= typeof user !== 'undefined' && user ? 'Your account' : 'Sign in or create an account' %></span>
          <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><circle cx="10" cy="6.5" r="3.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 18c.6-3.6 3.3-5.5 6.5-5.5s5.9 1.9 6.5 5.5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        </a>
        <button class="icon-btn" type="button" id="cart-open" aria-haspopup="dialog" aria-controls="cart-drawer">
          <span class="sr-only">Open bag, </span>
          <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M4 6h12l-1 11H5L4 6z" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M7.5 6V4.5a2.5 2.5 0 015 0V6" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
          <span class="count" data-cart-count aria-hidden="true"><%= typeof cartCount !== 'undefined' ? cartCount : 0 %></span>
          <span class="sr-only" data-cart-count-sr><%= typeof cartCount !== 'undefined' ? cartCount : 0 %> item<%= (typeof cartCount !== 'undefined' ? cartCount : 0) === 1 ? '' : 's' %></span>
        </button>
      </div>
    </div>
  </div>

  <%- include('../components/search-panel') %>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile" data-open="false">
    <ul>
      <li><a href="/shop">Shop all</a></li>
      <li><a href="/shop?category=rings">Rings</a></li>
      <li><a href="/shop?category=chains">Chains</a></li>
      <li><a href="/shop?category=pendants">Pendants</a></li>
      <li><a href="/shop?category=bracelets">Bracelets</a></li>
      <li><a href="/shop?category=earrings">Earrings</a></li>
      <li><a href="/shop?category=accessories">Accessories</a></li>
      <li><a href="/account/wishlist">Wishlist</a></li>
      <li><a href="/account"><%= typeof user !== 'undefined' && user ? 'Your account' : 'Sign in' %></a></li>
      <li><a href="/track-order">Track an order</a></li>
    </ul>
  </nav>
</header>

<%- include('../components/cart-drawer') %>
